# AI Arena Environment Configuration
# Copy this file to `.env` before running locally or in Docker.

NODE_ENV=development
PORT=5000
CLIENT_ORIGIN=http://localhost:5173

# PostgreSQL (pgAdmin 4 compatible)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ai_arena_db
PGHOST=localhost
PGPORT=5432
PGDATABASE=ai_arena_db
PGUSER=postgres
PGPASSWORD=postgres

# JWT Auth Secrets (Replace with long random strings in production)
JWT_SECRET=replace-with-strong-random-jwt-secret
JWT_REFRESH_SECRET=replace-with-strong-random-refresh-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_DAYS=14

# External AI Providers (Optional for offline Simulation Mode, required for Live AI)
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
GROQ_WHISPER_MODEL=whisper-large-v3-turbo
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# AI Quota & Multiplayer
AI_DAILY_QUOTA_PER_USER=60
MULTIPLAYER_ENABLED=true
